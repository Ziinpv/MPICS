generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgType {
  system
  province
  district
  commune
}

enum UserRole {
  ADMIN
  USER
}

/// Phân loại thiết bị IoT / truyền thông ngoài trời
enum DeviceType {
  communication_device /// Thiết bị truyền thông thông minh (ex: loa thông minh)
  billboard            /// Bảng hiệu / digital sign
  wind_banner          /// Bạt gió / banner
}

enum DeviceStatus {
  active
  maintenance
  retired
}

/// Phân loại địa điểm / tài sản GIS (gồm tài sản văn hóa + loại thiết bị ngoài trời)
enum LocationType {
  cultural_site
  religious_site
  communication_device /// Thiết bị truyền thông thông minh
  billboard            /// Bảng hiệu
  wind_banner          /// Bạt gió
}

enum OperationStatus {
  active
  inactive
  suspended
  expired
}

enum LocationStatus {
  draft
  active
  archived
}

enum ContentStatus {
  draft
  pending
  approved
  tts_processing
  ready_to_air
  rejected
  scheduled
  aired
}

enum ContentCategory {
  heritage
  festival
  admin_notice
  emergency
  other
}

enum CampaignType {
  periodic
  oneshot
  emergency
}

enum ScheduleStatus {
  scheduled
  running
  completed
  cancelled
  failed
}

enum CommandType {
  set_volume
  reboot
  power_on
  power_off
  play
  stop
  cache_media
}

enum CommandStatus {
  pending
  sent
  acked
  failed
  timeout
}

enum IncidentStatus {
  open
  assigned
  in_progress
  resolved
  closed
}

enum IncidentSeverity {
  low
  medium
  high
}

model Organization {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  type      OrgType
  parentId  String?
  parent    Organization?  @relation("OrgTree", fields: [parentId], references: [id])
  children  Organization[] @relation("OrgTree")
  path      String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  clusters        DeviceCluster[]
  devices         Device[]
  locations       Location[]
  contents        Content[]
  campaigns       Campaign[]
  incidents       IncidentReport[]
  provinceLocations Location[] @relation("ProvinceOrg")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  fullName     String
  phone        String?
  email        String?
  role         UserRole
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  status       String   @default("active")
  /// Bắt buộc đổi mật khẩu trước khi dùng app (user mới / reset)
  mustChangePassword Boolean @default(false)
  passwordChangedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  locations       Location[]
  contents        Content[]
  commands        DeviceCommand[]
  incidents       IncidentReport[] @relation("Reporter")
  assignedIncidents IncidentReport[] @relation("Assignee")
  schedules       BroadcastSchedule[]
  passwordResetTokens PasswordResetToken[]
  moderationReviews   ModerationReview[] @relation("ModerationReviewer")
  reviewedContents    Content[] @relation("ContentReviewer")
  resolvedAlerts      DeviceAlert[] @relation("AlertResolver")
  incidentComments    IncidentComment[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Nhật ký thao tác tối thiểu (P0 hardening)
model AuditLog {
  id            String   @id @default(cuid())
  actorId       String?
  actorUsername String?
  action        String
  entityType    String?
  entityId      String?
  meta          Json?
  ip            String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([actorId])
}

model DeviceCluster {
  id          String   @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id])
  code        String
  name        String
  description String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  devices Device[]
  targets ScheduleTarget[]
}

model Device {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id])
  clusterId       String?
  cluster         DeviceCluster? @relation(fields: [clusterId], references: [id])
  deviceCode      String       @unique
  name            String
  type            DeviceType   @default(communication_device)
  lat             Float?
  lng             Float?
  address         String?
  volumeDefault   Int          @default(70)
  status          DeviceStatus @default(active)
  online          Boolean      @default(false)
  lastSeenAt      DateTime?
  rssi            Int?
  volume          Int          @default(70)
  /// MQTT username (= deviceCode). Password hash bcrypt; plaintext chỉ trả khi rotate.
  mqttPasswordHash String?
  mqttPasswordSetAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  commands  DeviceCommand[]
  incidents IncidentReport[]
  linkedLocations Location[]
  alerts    DeviceAlert[]
  playLogs  DevicePlayLog[]
}

model Location {
  id                 String          @id @default(cuid())
  orgId              String
  org                Organization    @relation(fields: [orgId], references: [id])
  provinceOrgId      String?
  provinceOrg        Organization?   @relation("ProvinceOrg", fields: [provinceOrgId], references: [id])
  createdById        String
  createdBy          User            @relation(fields: [createdById], references: [id])
  name               String
  locationType       LocationType
  locationSubtype    String?
  address            String?
  lat                Float
  lng                Float
  licenseNumber      String?
  licenseConditions  String?
  licenseDate        DateTime?
  expiryDate         DateTime?
  operationStatus    OperationStatus @default(active)
  linkedDeviceId     String?
  linkedDevice       Device?         @relation(fields: [linkedDeviceId], references: [id])
  note               String?
  status             LocationStatus  @default(active)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  media LocationMedia[]
}

/// Catalog chi tiết loại địa điểm (CRUD Admin) — gắn nhóm LocationType
model LocationTypeDef {
  id        String       @id @default(cuid())
  groupType LocationType
  code      String
  name      String
  active    Boolean      @default(true)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([groupType, code])
  @@index([groupType, active])
}

model LocationMedia {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  storageKey String
  mimeType   String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
}

model Content {
  id          String          @id @default(cuid())
  orgId       String
  org         Organization    @relation(fields: [orgId], references: [id])
  authorId    String
  author      User            @relation(fields: [authorId], references: [id])
  title       String
  bodyPlain   String
  category    ContentCategory @default(other)
  status      ContentStatus   @default(draft)
  mediaAssetId String?
  mediaAsset  MediaAsset?     @relation(fields: [mediaAssetId], references: [id])
  rejectionReason String?
  reviewedById String?
  reviewedBy   User?          @relation("ContentReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  items   BroadcastItem[]
  ttsJobs TtsJob[]
  reviews ModerationReview[]
}

enum ModerationAction {
  submit
  approve
  reject
  request_revision
}

model ModerationReview {
  id         String           @id @default(cuid())
  contentId  String
  content    Content          @relation(fields: [contentId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User             @relation("ModerationReviewer", fields: [reviewerId], references: [id])
  action     ModerationAction
  reason     String?
  createdAt  DateTime         @default(now())

  @@index([contentId, createdAt])
}

model MediaAsset {
  id           String   @id @default(cuid())
  storageKey   String
  cdnUrl       String
  mimeType     String   @default("audio/mpeg")
  durationSec  Int      @default(60)
  checksum     String?
  signature    String?
  createdAt    DateTime @default(now())

  contents Content[]
  items    BroadcastItem[]
  ttsJobs  TtsJob[]
}

enum TtsJobStatus {
  queued
  running
  done
  failed
}

model TtsJob {
  id           String       @id @default(cuid())
  contentId    String
  content      Content      @relation(fields: [contentId], references: [id], onDelete: Cascade)
  status       TtsJobStatus @default(queued)
  voice        String       @default("vi-VN-HoaiMyNeural")
  driver       String       @default("edge")
  error        String?
  mediaAssetId String?
  mediaAsset   MediaAsset?  @relation(fields: [mediaAssetId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  finishedAt   DateTime?

  @@index([status, createdAt])
  @@index([contentId])
}

model Campaign {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id])
  name      String
  type      CampaignType @default(oneshot)
  priority  Int          @default(0)
  status    String       @default("active")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  schedules BroadcastSchedule[]
}

model BroadcastSchedule {
  id              String         @id @default(cuid())
  campaignId      String
  campaign        Campaign       @relation(fields: [campaignId], references: [id])
  name            String
  startAt         DateTime
  /// Lặp lại mỗi N phút (null = oneshot)
  intervalMinutes Int?
  nextRunAt       DateTime?
  endAt           DateTime?
  /// Khung giờ trong ngày (phút từ 00:00). Null = cả ngày.
  windowStartMin  Int?
  windowEndMin    Int?
  timezone        String         @default("Asia/Ho_Chi_Minh")
  preempt         Boolean        @default(false)
  status          ScheduleStatus @default(scheduled)
  createdById     String?
  createdBy       User?          @relation(fields: [createdById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  items   BroadcastItem[]
  targets ScheduleTarget[]

  @@index([nextRunAt])
  @@index([startAt])
}

model BroadcastItem {
  id            String            @id @default(cuid())
  scheduleId    String
  schedule      BroadcastSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  contentId     String?
  content       Content?          @relation(fields: [contentId], references: [id])
  mediaAssetId  String?
  mediaAsset    MediaAsset?       @relation(fields: [mediaAssetId], references: [id])
  sortOrder     Int               @default(0)
}

model ScheduleTarget {
  id         String            @id @default(cuid())
  scheduleId String
  schedule   BroadcastSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  clusterId  String
  cluster    DeviceCluster     @relation(fields: [clusterId], references: [id])
  include    Boolean           @default(true)
}

model DeviceCommand {
  id            String        @id @default(cuid())
  deviceId      String
  device        Device        @relation(fields: [deviceId], references: [id])
  commandType   CommandType
  payload       Json?
  issuedById    String?
  issuedBy      User?         @relation(fields: [issuedById], references: [id])
  status        CommandStatus @default(pending)
  scheduleId    String?
  createdAt     DateTime      @default(now())
  sentAt        DateTime?
  ackedAt       DateTime?

  playLogs DevicePlayLog[]
}

/// Nhật ký phát trên thiết bị (ack play / lỗi)
model DevicePlayLog {
  id          String   @id @default(cuid())
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  commandId   String?
  command     DeviceCommand? @relation(fields: [commandId], references: [id], onDelete: SetNull)
  scheduleId  String?
  title       String?
  status      String   @default("ok") // ok | error
  error       String?
  playedAt    DateTime @default(now())

  @@index([deviceId, playedAt])
  @@index([scheduleId])
  @@index([playedAt])
}

model IncidentReport {
  id          String           @id @default(cuid())
  deviceId    String
  device      Device           @relation(fields: [deviceId], references: [id])
  reporterId  String
  reporter    User             @relation("Reporter", fields: [reporterId], references: [id])
  orgId       String
  org         Organization     @relation(fields: [orgId], references: [id])
  title       String
  description String
  photoKeys   String[]         @default([])
  severity    IncidentSeverity @default(medium)
  status      IncidentStatus   @default(open)
  assigneeId  String?
  assignee    User?            @relation("Assignee", fields: [assigneeId], references: [id])
  createdAt   DateTime         @default(now())
  resolvedAt  DateTime?
  comments    IncidentComment[]
}

model IncidentComment {
  id         String         @id @default(cuid())
  incidentId String
  incident   IncidentReport @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  authorId   String
  author     User           @relation(fields: [authorId], references: [id])
  body       String
  createdAt  DateTime       @default(now())

  @@index([incidentId, createdAt])
}

enum DeviceAlertType {
  offline
  low_battery
  storage_full
  other
}

enum DeviceAlertStatus {
  open
  acked
  resolved
}

/// Cảnh báo thiết bị (telemetry) — nền tảng SLA online
model DeviceAlert {
  id          String            @id @default(cuid())
  deviceId    String
  device      Device            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  type        DeviceAlertType   @default(offline)
  severity    IncidentSeverity  @default(high)
  status      DeviceAlertStatus @default(open)
  message     String
  offlineMinutes Int?
  resolvedById String?
  resolvedBy  User?             @relation("AlertResolver", fields: [resolvedById], references: [id])
  resolvedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([deviceId, type, status])
}
