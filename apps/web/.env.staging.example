# Copy → apps/web/.env.staging — KHÔNG commit
# Dùng với: docker compose -f docker-compose.staging.yml --env-file apps/web/.env.staging up -d

POSTGRES_USER="mpcis"
POSTGRES_PASSWORD="CHANGE_ME_DB_PASSWORD"
POSTGRES_DB="mpcis"

DATABASE_URL="postgresql://mpcis:CHANGE_ME_DB_PASSWORD@postgres:5432/mpcis?schema=public"

APP_ENV="staging"
NODE_ENV="production"

JWT_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"
JWT_EXPIRES_IN="8h"
COOKIE_SECURE="1"

NEXT_PUBLIC_SHOW_DEMO_HINTS="0"
NEXT_PUBLIC_APP_NAME="MPCIS Staging"
SEED_MUST_CHANGE_PASSWORD="1"

STORAGE_DRIVER="s3"
NEXT_PUBLIC_STORAGE_DRIVER="s3"
S3_ENDPOINT="http://minio:9000"
S3_ACCESS_KEY="CHANGE_ME_MINIO"
S3_SECRET_KEY="CHANGE_ME_MINIO_SECRET_MIN8"
S3_BUCKET="mpcis-media"
S3_REGION="us-east-1"
S3_FORCE_PATH_STYLE="1"

APP_PUBLIC_URL="https://staging.example.com"
EXPOSE_RESET_LINK="0"
RESET_TOKEN_HOURS="1"
GEO_VALIDATION="1"

CRON_SECRET="CHANGE_ME_CRON"
MEDIA_SIGNING_SECRET="CHANGE_ME_MEDIA_SIGN"
COMMAND_TIMEOUT_MINUTES="5"

TTS_DRIVER="edge"
TTS_VOICE="vi-VN-HoaiMyNeural"
TTS_PYTHON="python3"
TTS_FALLBACK_MOCK="1"

MQTT_URL="mqtts://mosquitto:8883"
MQTT_TLS_INSECURE="1"
MQTT_BRIDGE_USER="bridge"
MQTT_BRIDGE_PASSWORD="CHANGE_ME_BRIDGE"
MQTT_USERNAME="bridge"
MQTT_PASSWORD="CHANGE_ME_BRIDGE"
MQTT_TOPIC_PREFIX="mpcis"

# SMTP_HOST=
# SMTP_PORT=587
# SMTP_FROM="MPCIS <noreply@example.com>"
