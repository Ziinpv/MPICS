# Copy thành apps/web/.env trên máy staging — KHÔNG commit file .env thật
DATABASE_URL="postgresql://mpcis:CHANGE_ME_DB_PASSWORD@127.0.0.1:5433/mpcis?schema=public"

APP_ENV="staging"
NODE_ENV="production"

# Secret dài, ngẫu nhiên (≥32 ký tự). Không dùng giá trị demo.
JWT_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="8h"

COOKIE_SECURE="1"

NEXT_PUBLIC_SHOW_DEMO_HINTS="0"
NEXT_PUBLIC_APP_NAME="MPCIS Staging"

# Seed staging: bắt buộc đổi MK sau seed
SEED_MUST_CHANGE_PASSWORD="1"

# Media — MinIO / S3
STORAGE_DRIVER="s3"
NEXT_PUBLIC_STORAGE_DRIVER="s3"
S3_ENDPOINT="http://127.0.0.1:9000"
S3_ACCESS_KEY="CHANGE_ME"
S3_SECRET_KEY="CHANGE_ME"
S3_BUCKET="mpcis-media"
S3_REGION="us-east-1"
S3_FORCE_PATH_STYLE="1"

