DATABASE_URL="postgresql://mpcis:mpcis@127.0.0.1:5433/mpcis?schema=public"

# Bắt buộc đổi secret trên staging/prod (không dùng giá trị demo)
JWT_SECRET="mpcis-demo-secret-change-me"
JWT_EXPIRES_IN="7d"

# development | demo | staging | production
APP_ENV="development"

# Hiển thị quick-login + mật khẩu seed trên /login (tắt trên staging)
NEXT_PUBLIC_SHOW_DEMO_HINTS="1"
NEXT_PUBLIC_APP_NAME="MPCIS Demo"

# Seed: bắt buộc user seed đổi MK lần đầu (1/true)
# SEED_MUST_CHANGE_PASSWORD="0"

# Cookie Secure (mặc định bật khi NODE_ENV=production)
# COOKIE_SECURE="0"
