DATABASE_URL="postgresql://mpcis:mpcis@127.0.0.1:5433/mpcis?schema=public"

# Bắt buộc đổi secret trên staging/prod (không dùng giá trị demo)
JWT_SECRET="mpcis-demo-secret-change-me"
JWT_EXPIRES_IN="7d"

# development | demo | staging | production
APP_ENV="development"

# Hiển thị quick-login + mật khẩu seed trên /login (tắt trên staging)
NEXT_PUBLIC_SHOW_DEMO_HINTS="1"
NEXT_PUBLIC_APP_NAME="MPCIS Demo"

# Seed: bắt buộc user seed đổi MK lần đầu (1/true)
# SEED_MUST_CHANGE_PASSWORD="0"

# Cookie Secure (mặc định bật khi NODE_ENV=production)
# COOKIE_SECURE="0"

# Media storage: local (public/uploads) | s3 (MinIO)
STORAGE_DRIVER="local"
NEXT_PUBLIC_STORAGE_DRIVER="local"
# Khi dùng MinIO:
# STORAGE_DRIVER="s3"
# NEXT_PUBLIC_STORAGE_DRIVER="s3"
# S3_ENDPOINT="http://127.0.0.1:9000"
# S3_ACCESS_KEY="mpcis"
# S3_SECRET_KEY="mpcisminio"
# S3_BUCKET="mpcis-media"
# S3_REGION="us-east-1"
# S3_FORCE_PATH_STYLE="1"

# Validate tọa độ theo bbox xã/tỉnh (0 để tắt)
GEO_VALIDATION="1"

# Quên mật khẩu
APP_PUBLIC_URL="http://localhost:3000"
# EXPOSE_RESET_LINK="1"   # mặc định bật trên development
# RESET_TOKEN_HOURS="1"

# SMTP (optional) — local Mailpit: docker compose up -d mailpit · UI :8025
# SMTP_HOST="127.0.0.1"
# SMTP_PORT="1025"
# SMTP_SECURE="0"
# SMTP_FROM="MPCIS <noreply@mpcis.local>"
# SMTP_USER=
# SMTP_PASS=

# MQTT (P2) — Mosquitto: user mpcis / mpcismqtt (infra/mosquitto/passwd)
# MQTT_URL="mqtt://127.0.0.1:1883"
# MQTT_USERNAME="mpcis"
# MQTT_PASSWORD="mpcismqtt"
# MQTT_TOPIC_PREFIX="mpcis"
# MQTT_BRIDGE_POLL_MS="4000"
# DEVICE_CODES="COM-XA1-01,COM-XA1-02,COM-XA2-01"

# Jobs / cron (timeout lệnh + lịch định kỳ)
# COMMAND_TIMEOUT_MINUTES="5"
# CRON_SECRET="change-me-cron-secret"
# BASE_URL="http://localhost:3000"
